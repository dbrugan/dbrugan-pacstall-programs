pkgbase = limine-snapper-sync
	pkgver = 1.32.1
	pkgrel = 1
	pkgdesc = Synchronizes Limine boot entries with Snapper Btrfs snapshots
	url = https://gitlab.com/Zesko/limine-snapper-sync
	arch = amd64
	depends = bash
	depends = btrfs-progs
	depends = coreutils
	depends = libnotify
	depends = procps
	depends = sed
	depends = snapper
	depends = systemd
	depends = util-linux
	makedepends = gcc
	makedepends = gettext
	makedepends = git
	makedepends = libc6-dev
	makedepends = zlib1g-dev
	optdepends = inotify-tools: Watches snapshot creation/deletion (otherwise the Snapper plugin drives syncs)
	optdepends = rsync: Needed for RESTORE_METHOD=rsync
	optdepends = xxhash: Faster xxhsum hashing for deduplication
	optdepends = b3sum: Blake3 hashing for deduplication
	pacdeps = limine
	backup = etc/limine-snapper-sync.conf
	license = GPL-3.0-or-later
	maintainer = dbrugan <dbrugan@protonmail.com>
	source = git+https://gitlab.com/Zesko/limine-snapper-sync.git#commit=b4c0da2d4532a993809219f9e5d51a1fa85fcb93
	source = https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.2.4/graalvm-community-jdk-25i2-25.0.4_linux-x64_bin.tar.gz
	source = https://services.gradle.org/distributions/gradle-9.8.0-bin.zip
	sha256sums = SKIP
	sha256sums = 3f4a89de8eaa96f2ed677f09957c7e872cd8467aad3537f8b5394c1b8c4b942e
